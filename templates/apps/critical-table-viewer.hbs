<div class="critical-table-viewer-body">
  <div class="table-toolbar">
    <button type="button" data-action="rollLookup">
      <i class="fas fa-dice"></i> Roll d100
    </button>
    {{#if isCritical}}
    <div class="severity-chips" title="{{localize "VSDSIMPLE.Crit.severityHint"}}">
      {{#each severities as |s|}}
      <button type="button" class="severity-chip" data-action="rollSeverity" data-severity="{{s.key}}" data-mod="{{s.mod}}" title="{{s.key}} {{#if s.mod}}+{{s.mod}}{{else}}+0{{/if}}">
        {{s.label}}{{#if s.mod}}+{{s.mod}}{{/if}}
      </button>
      {{/each}}
    </div>
    <button type="button" data-action="openHitCharts">
      <i class="fas fa-shield-halved"></i> {{localize "VSDSIMPLE.Crit.openHitCharts"}}
    </button>
    {{/if}}
    {{#if isAttack}}
    <button type="button" data-action="openCritCharts">
      <i class="fas fa-book-dead"></i> {{localize "VSDSIMPLE.Crit.critCharts"}}
    </button>
    {{/if}}
    <button type="button" data-action="openBrowser">
      <i class="fas fa-list"></i> {{localize "VSDSIMPLE.Crit.allTables"}}
    </button>
    <span class="table-name">{{table.label}}</span>
  </div>
  <div class="table-content">
    {{{content}}}
  </div>
</div>
