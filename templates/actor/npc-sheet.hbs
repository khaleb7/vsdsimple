<div class="npc-sheet vsd-npc-wrapper">
    <header class="npc-header">
      <img class="header-logo" src="{{logo}}" alt="VsD" />
      <div class="npc-identity">
        <input class="npc-name" name="name" type="text" value="{{actor.name}}" placeholder="Creature Name" />
        <img class="portrait" src="{{actor.img}}" data-action="editImage" data-edit="img" title="{{actor.name}}" />
      </div>
    </header>

    <nav class="sheet-nav tabs" data-group="primary">
      {{#each tabs}}
      <a class="tabtitle{{#if cssClass}} {{cssClass}}{{/if}}" data-action="tab" data-group="primary" data-tab="{{id}}">{{localize label}}</a>
      {{/each}}
    </nav>

    <section class="sheet-body">
      <div class="tab form-page{{#if tabs.stats.active}} active{{/if}}" data-group="primary" data-tab="stats">
        <table class="npc-stat-block">
          <tbody>
            <tr>
              <th>Level</th>
              <td class="level-cell">
                <input name="system.level" type="number" value="{{system.level}}" />
                <input name="system.levelType" type="text" value="{{system.levelType}}" placeholder="Common" />
              </td>
            </tr>
            <tr>
              <th>MR</th>
              <td><input name="system.mr" type="text" value="{{system.mr}}" placeholder="17L" /></td>
            </tr>
            <tr>
              <th>AT</th>
              <td><input name="system.at" type="text" value="{{system.at}}" placeholder="NA" /></td>
            </tr>
            <tr>
              <th><a class="roll-label" data-action="rollField" data-field="def">DEF</a></th>
              <td><input name="system.def" type="number" value="{{system.def}}" /></td>
            </tr>
            <tr>
              <th><a class="roll-label" data-action="rollField" data-field="tsr">TSR</a></th>
              <td><input name="system.tsr" type="number" value="{{system.tsr}}" /></td>
            </tr>
            <tr>
              <th><a class="roll-label" data-action="rollField" data-field="wsr">WSR</a></th>
              <td><input name="system.wsr" type="number" value="{{system.wsr}}" /></td>
            </tr>
            <tr>
              <th>HPs</th>
              <td class="hp-cell">
                <span class="boxed readonly" title="Current">{{system.hp.value}}</span>
                <span>/</span>
                <span class="boxed readonly" title="Max">{{system.hp.max}}</span>
                <span class="hint inline-hint">Edit on Combat</span>
              </td>
            </tr>
            {{#each attackSlots as |atk|}}
            <tr>
              <th>
                {{#unless atk.empty}}
                <a class="roll-label" data-action="rollAttack" data-slot="{{atk.slot}}">{{atk.heading}}</a>
                {{else}}
                {{atk.heading}}
                {{/unless}}
              </th>
              <td class="atk-cell">
                <div class="atk-main">
                  <input name="system.attacks.{{atk.slot}}.bonus" type="number" value="{{atk.bonus}}" placeholder="+" />
                  <input name="system.attacks.{{atk.slot}}.label" type="text" value="{{atk.label}}" placeholder="{{atk.placeholder}}" />
                </div>
                <div class="atk-type-row">
                  <select name="system.attacks.{{atk.slot}}.type" title="Attack type / tables">
                    <option value="">Type…</option>
                    {{#each atk.typeOptions as |opt|}}
                    <option value="{{opt.key}}" {{#if opt.selected}}selected{{/if}}>{{opt.label}}</option>
                    {{/each}}
                  </select>
                  {{#if atk.tablesHint}}
                  <span class="atk-tables-hint">{{atk.tablesHint}}</span>
                  {{/if}}
                </div>
              </td>
            </tr>
            {{/each}}
            <tr>
              <th>Special</th>
              <td><input name="system.special" type="text" value="{{system.special}}" /></td>
            </tr>
            <tr>
              <th>CT</th>
              <td><input name="system.ct" type="text" value="{{system.ct}}" placeholder="NH" /></td>
            </tr>
            <tr>
              <th><a class="roll-label" data-action="rollField" data-field="rog">Rog</a></th>
              <td><input name="system.rog" type="number" value="{{system.rog}}" /></td>
            </tr>
            <tr>
              <th><a class="roll-label" data-action="rollField" data-field="adv">Adv</a></th>
              <td><input name="system.adv" type="number" value="{{system.adv}}" /></td>
            </tr>
            <tr>
              <th><a class="roll-label" data-action="rollField" data-field="lor">Lor</a></th>
              <td><input name="system.lor" type="number" value="{{system.lor}}" /></td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="tab form-page{{#if tabs.combat.active}} active{{/if}}" data-group="primary" data-tab="combat">
        <div class="form-top-bar npc-combat-top">
          <div class="hp-block">
            <h3 class="form-section-title">Hit Points</h3>
            <div class="hp-fields">
              <label>
                <span>Current</span>
                <input class="boxed" type="number" name="system.hp.value" value="{{system.hp.value}}" />
              </label>
              <label>
                <span>Max</span>
                <input class="boxed" type="number" name="system.hp.max" value="{{system.hp.max}}" />
              </label>
            </div>
            <div class="pool-quick-btns">
              <button type="button" data-action="adjustHp" data-field="value" data-delta="-5">−5</button>
              <button type="button" data-action="adjustHp" data-field="value" data-delta="-1">−1</button>
              <button type="button" data-action="adjustHp" data-field="value" data-delta="1">+1</button>
              <button type="button" data-action="adjustHp" data-field="value" data-delta="5">+5</button>
            </div>
          </div>
          <div class="wounds-block">
            <h3 class="form-section-title">Wounds</h3>
            <div class="hp-fields">
              <label><span>Bleed</span><span class="boxed readonly">{{derived.woundsBleed}}</span></label>
              <label><span>Penalties</span><span class="boxed readonly">{{derived.woundsPenalty}}</span></label>
            </div>
          </div>
        </div>

        <section class="form-section">
          <h3 class="form-section-title">Conditions</h3>
          <p class="hint">Toggle on the actor/token. No automatic modifiers.</p>
          <div class="conditions-grid">
            {{#each statusEffects as |se|}}
            <label class="condition-toggle{{#if se.active}} inEffect{{/if}}" data-action="toggleStatus" data-status-id="{{se.id}}" title="{{se.label}}">
              <img src="{{se.img}}" alt="" width="20" height="20" />
              <span>{{se.label}}</span>
            </label>
            {{/each}}
          </div>
        </section>

        <section class="form-section">
          <h3 class="form-section-title">Injuries <a data-action="addWound" title="Add injury"><i class="fas fa-plus"></i></a></h3>
          <p class="hint">Bleed / Penalties above are totals of the rows below.</p>
          {{#if system.wounds.length}}
          <div class="injury-line injury-header">
            <span>Injury</span>
            <span>Bleed</span>
            <span>Pen</span>
            <span>Notes</span>
            <span></span>
            <span></span>
          </div>
          {{/if}}
          {{#each system.wounds as |w i|}}
          <div class="injury-line">
            <input type="text" name="system.wounds.{{i}}.name" value="{{w.name}}" placeholder="Injury" />
            <input type="number" name="system.wounds.{{i}}.bleed" value="{{w.bleed}}" title="Bleed" placeholder="0" />
            <input type="number" name="system.wounds.{{i}}.penalty" value="{{w.penalty}}" title="Penalty" placeholder="0" />
            <input type="text" name="system.wounds.{{i}}.notes" value="{{w.notes}}" placeholder="Notes" />
            <a data-action="duplicateWound" data-index="{{i}}" title="Duplicate"><i class="fas fa-copy"></i></a>
            <a data-action="deleteWound" data-index="{{i}}" title="Remove"><i class="fas fa-trash"></i></a>
          </div>
          {{/each}}
        </section>
      </div>

      <div class="tab form-page{{#if tabs.notes.active}} active{{/if}}" data-group="primary" data-tab="notes">
        <section class="form-section npc-notes">
          <h3 class="form-section-title">Notes</h3>
          <textarea name="system.notes" rows="16" placeholder="Description, tactics, treasure…">{{system.notes}}</textarea>
        </section>
      </div>
    </section>
  </div>
